        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "tachyon-prometheus"
          },
          "expr": "sum(rate(tachyon_jobs_picked_up_total{region=~\"$region\", vcpu=~\"$vcpu\"}[$__rate_interval])) * 60",
          "legendFormat": "picked up / min"
        }
      ],

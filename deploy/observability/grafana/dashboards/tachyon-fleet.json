      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      }
    },
    {
      "type": "timeseries",
      "title": "Warm VMs by size",
      "description": "Paused VMs ready for assignment; zero means jobs wait for a restore.",

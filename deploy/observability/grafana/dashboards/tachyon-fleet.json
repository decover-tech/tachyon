    {
      "type": "timeseries",
      "title": "Prebuild hit rate",
      "description": "Share of finished jobs that forked a full or partial prebuild, or none.",
      "datasource": {
        "type": "prometheus",
        "uid": "tachyon-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tachyon-prometheus"
          },
          "expr": "sum by (prebuild_match) (rate(tachyon_jobs_finished_total{region=~\"$region\", vcpu=~\"$vcpu\"}[$__rate_interval])) / ignoring (prebuild_match) group_left sum(rate(tachyon_jobs_finished_total{region=~\"$region\", vcpu=~\"$vcpu\"}[$__rate_interval]))",
          "legendFormat": "{{prebuild_match}}"
        }
      ],
      "id": 12,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      }
    },
    {
      "type": "timeseries",
      "title": "Cache hit rate",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "tachyon-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tachyon-prometheus"
          },
          "expr": "sum(rate(tachyon_cache_requests_total{result=\"hit\", region=~\"$region\"}[$__rate_interval])) / sum(rate(tachyon_cache_requests_total{region=~\"$region\"}[$__rate_interval]))",
          "legendFormat": "hit rate"
        }
      ],
      "id": 13,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      }
    },

    {
      "type": "timeseries",
      "title": "Oversubscription slowdown (median run time, oversubscribed / not)",
      "description": "Crude: job mix differs between hosts. The Job analytics dashboard normalizes per repo.",
      "datasource": {
        "type": "prometheus",
        "uid": "tachyon-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1.1
              }
            ]

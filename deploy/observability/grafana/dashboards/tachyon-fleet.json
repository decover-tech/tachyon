    {
      "type": "timeseries",
      "title": "Cost per job-minute",
      "description": "Capacity cost over billable runner minutes, owned versus burst.",
      "datasource": {
        "type": "prometheus",
        "uid": "tachyon-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"

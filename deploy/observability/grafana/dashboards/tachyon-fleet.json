{
  "uid": "tachyon-fleet",
  "title": "Tachyon fleet",
  "description": "Pickup latency, prebuild and cache hit rates, host utilization, cost and SLOs. Source: Prometheus.",
  "tags": [
    "tachyon"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "utc",
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "region",
        "label": "Region",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "tachyon-prometheus"
        },
        "query": {
          "query": "label_values(tachyon_job_pickup_seconds_bucket, region)",
          "refId": "V"
        },
        "definition": "label_values(tachyon_job_pickup_seconds_bucket, region)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "vcpu",
        "label": "VM size",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "tachyon-prometheus"
        },
        "query": {
          "query": "label_values(tachyon_job_pickup_seconds_bucket, vcpu)",
          "refId": "V"
        },
        "definition": "label_values(tachyon_job_pickup_seconds_bucket, vcpu)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "SLOs",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Pickup success (30d, SLO 99.9%)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "tachyon-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0.99,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.999
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tachyon-prometheus"
          },
          "expr": "1 - tachyon:pickup_errors:ratio_rate30d",
          "legendFormat": "picked up"
        }
      ],
      "id": 2,
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      }
    },

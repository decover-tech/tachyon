    {
      "type": "timeseries",
      "title": "Jobs queued vs picked up",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "tachyon-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tachyon-prometheus"
          },
          "expr": "sum(rate(tachyon_jobs_queued_total[$__rate_interval])) * 60",
          "legendFormat": "queued / min"

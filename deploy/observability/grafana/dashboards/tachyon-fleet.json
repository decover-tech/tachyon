    {
      "type": "timeseries",
      "title": "Pickup p50 by region and size",
      "description": "Webhook received to runner online.",
      "datasource": {
        "type": "prometheus",
        "uid": "tachyon-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tachyon-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, region, vcpu) (rate(tachyon_job_pickup_seconds_bucket{region=~\"$region\", vcpu=~\"$vcpu\"}[$__rate_interval])))",
          "legendFormat": "{{region}} {{vcpu}}x p50"
        }
      ],
      "id": 7,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
      }
    },
    {
      "type": "timeseries",
      "title": "Pickup p95 by region and size",
      "description": "",
      "datasource": {
        "type": "prometheus",

        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tachyon-prometheus"
          },
          "expr": "sum by (capacity) (rate(tachyon_job_cost_usd_total{region=~\"$region\"}[1h])) / (sum by (capacity) (rate(tachyon_job_billable_seconds_total{region=~\"$region\"}[1h])) / 60)",

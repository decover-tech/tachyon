          "datasource": {
            "type": "prometheus",
            "uid": "tachyon-prometheus"
          },
          "expr": "sum by (region) (rate(tachyon_cache_restore_bytes_total{region=~\"$region\"}[$__rate_interval])) / sum by (region) (rate(tachyon_cache_restore_seconds_sum{region=~\"$region\"}[$__rate_interval]))",
          "legendFormat": "{{region}} per restore"
        }
      ],
      "id": 14,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      }
    },

[Unit]
Description=Tachyon guest agent
# hostd snapshots the VM as soon as the agent answers; eth0 must already be
# configured then, or every restored VM comes up without an address.
Wants=systemd-networkd-wait-online.service
After=systemd-networkd-wait-online.service
DefaultDependencies=no

[Service]
# The job overlay's lower layer (Layout.BaseRoot): the read-only base image
# alone, without the mounts on top of /.
ExecStartPre=/bin/mkdir -p /run/tachyon/base
ExecStartPre=/bin/mount --bind -o ro / /run/tachyon/base
ExecStart=/usr/local/bin/tachyon-guest
Restart=no

[Install]
WantedBy=multi-user.target
